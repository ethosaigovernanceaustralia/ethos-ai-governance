{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services.html",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/free-audit.html",
      "destination": "/free-audit",
      "permanent": true
    },
    {
      "source": "/free-audit/",
      "destination": "/free-audit",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/regulatory.html",
      "destination": "/regulatory",
      "permanent": true
    },
    {
      "source": "/regulatory/",
      "destination": "/regulatory",
      "permanent": true
    },
    {
      "source": "/resources.html",
      "destination": "/resources",
      "permanent": true
    },
    {
      "source": "/resources/",
      "destination": "/resources",
      "permanent": true
    },
    {
      "source": "/faq.html",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/faq/",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/free-audit",
      "destination": "/free-audit.html"
    },
    {
      "source": "/legal/terms",
      "destination": "/portal/terms.html"
    },
    {
      "source": "/legal/privacy",
      "destination": "/portal/privacy.html"
    },
    {
      "source": "/privacy",
      "destination": "/portal/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/portal/terms.html"
    },
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/regulatory",
      "destination": "/regulatory.html"
    },
    {
      "source": "/resources",
      "destination": "/resources.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/portal/login",
      "destination": "/portal/login.html"
    },
    {
      "source": "/portal/dashboard",
      "destination": "/portal/dashboard.html"
    },
    {
      "source": "/portal/admin",
      "destination": "/portal/admin.html"
    },
    {
      "source": "/portal/reset-password",
      "destination": "/portal/reset-password.html"
    },
    {
      "source": "/success",
      "destination": "/success.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://prxdqulcvqqrzqkptcwk.supabase.co wss://prxdqulcvqqrzqkptcwk.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; report-uri /api/csp-report; report-to csp"
        },
        {
          "key": "Reporting-Endpoints",
          "value": "csp=\"/api/csp-report\""
        }
      ]
    },
    {
      "source": "/portal/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/legal/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/success",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/send-recovery-emails",
      "schedule": "0 1 * * *"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
