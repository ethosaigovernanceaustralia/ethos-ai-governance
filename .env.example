# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key

# ─── Resend ───────────────────────────────────────────────────────────────────
# dashboard.resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Admin notification email (where new enquiry alerts are sent)
NOTIFY_EMAIL=your@email.com

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Dashboard → Developers → Webhooks → select endpoint → Signing Secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Enable Stripe's hosted Terms-of-Service checkbox on Checkout.
# Leave unset/false until a Terms of Service URL is configured in
# Stripe Dashboard → Settings → Checkout & Payment Links AND the final
# Engagement Terms legal doc is live. Engagement Terms are captured in-app
# regardless (see openEngagementTerms in app.js). Set to "true" to turn on.
STRIPE_COLLECT_TOS=false

# Recovery cron: required, never an empty production value.
CRON_SECRET=replace-with-a-random-secret

# Canonical portal origin used by notification links.
PORTAL_URL=https://ethosaigovernance.com.au

# send-notification uses SUPABASE_SECRET_KEY (with persisted authorisation, P5).
# The legacy SUPABASE_SERVICE_ROLE_KEY name is no longer read; do not set it.

# Preview/Development must use separate synthetic services and Stripe test keys.
# Never copy production runtime values into a test environment.
